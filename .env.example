# DollarPath - Configurações de Ambiente para Deploy em Nuvem

# Banco de Dados PostgreSQL (Local ou Nuvem: Neon, Supabase, Railway)
DATABASE_URL="postgresql://dollarpath_user:dollarpath_secure_password@localhost:5432/dollarpath_db?schema=public"

# Configuração da API
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Segredos de Autenticação (quando publicar em nuvem)
JWT_SECRET="gere_uma_chave_secreta_aleatoria_longa_aqui"
