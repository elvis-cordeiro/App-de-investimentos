datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssetType {
  STOCK
  ETF
  REIT
  CRYPTO
  CASH
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  FEE
  EXCHANGE
}

enum NewsCategory {
  URGENT
  PORTFOLIO
  OPPORTUNITY
  MARKET_OVERVIEW
}

enum FinancialEventType {
  PLANNED_CONTRIBUTION_MISSED
  CONTRIBUTION_BELOW_PLANNED
  WITHDRAWAL_OR_SALE
  ADDITIONAL_CONTRIBUTION
  ASSUMPTION_CHANGED
}

enum AlertPriority {
  IMPORTANT
  INFO
}

model Asset {
  id              String        @id @default(uuid())
  ticker          String        @unique
  name            String
  type            AssetType     @default(STOCK)
  sector          String
  currency        String        @default("USD")
  country         String        @default("US")
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
  dividends       Dividend[]
  newsRelations   NewsAsset[]
  opportunities   Opportunity[]
}

model Transaction {
  id              String          @id @default(uuid())
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id])
  type            TransactionType
  date            DateTime
  quantity        Decimal         @db.Decimal(18, 6)
  unitPrice       Decimal         @db.Decimal(18, 4)
  currency        String          @default("USD")
  exchangeRate    Decimal?        @db.Decimal(18, 4)
  fees            Decimal?        @db.Decimal(18, 4)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MonthlyBudget {
  id                      String    @id @default(uuid())
  month                   String    @unique
  income                  Decimal   @db.Decimal(18, 2)
  expenses                Decimal   @db.Decimal(18, 2)
  emergencyReserveBalance Decimal   @db.Decimal(18, 2)
  plannedInvestment       Decimal   @db.Decimal(18, 2)
  currency                String    @default("BRL")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Dividend {
  id             String    @id @default(uuid())
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id])
  exDate         DateTime
  paymentDate    DateTime
  amountPerShare Decimal   @db.Decimal(18, 4)
  quantity       Decimal   @db.Decimal(18, 6)
  totalAmount    Decimal   @db.Decimal(18, 4)
  currency       String    @default("USD")
  createdAt      DateTime  @default(now())
}

model NewsArticle {
  id                        String       @id @default(uuid())
  title                     String
  summary                   String
  analysis                  String?
  isInterpretationConfirmed Boolean      @default(false)
  source                    String
  url                       String
  publishedAt               DateTime
  collectedAt               DateTime     @default(now())
  imageUrl                  String?
  category                  NewsCategory @default(MARKET_OVERVIEW)
  isBreaking                Boolean      @default(false)
  status                    String       @default("ACTIVE")

  assets                    NewsAsset[]
}

model NewsAsset {
  newsId      String
  assetId     String
  relevance   Int          @default(1)
  relation    String?

  news        NewsArticle  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([newsId, assetId])
}

model Opportunity {
  id           String    @id @default(uuid())
  ticker       String
  assetId      String?
  asset        Asset?    @relation(fields: [assetId], references: [id])
  thesis       String
  sector       String
  score        Decimal?  @db.Decimal(5, 2)
  risks        String[]
  catalysts    String[]
  radarStyle   String    @default("GROWTH_WITH_FUNDAMENTALS")
  reviewDate   DateTime  @default(now())
  status       String    @default("ACTIVE")
}

model Goal {
  id           String    @id @default(uuid())
  name         String
  targetValue  Decimal   @db.Decimal(18, 2)
  currentValue Decimal   @db.Decimal(18, 2)
  currency     String    @default("BRL")
  deadlineYears Int
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projections  GoalProjection[]
}

/* ========================================================
 * DollarPath Intelligence - Entities v1.1
 * ======================================================== */

model DecisionLog {
  id                 String             @id @default(uuid())
  timestamp          DateTime           @default(now())
  eventType          FinancialEventType
  description        String
  advisorExplanation String
  contributionDelta  Decimal            @db.Decimal(18, 2)
  assetGrowthDelta   Decimal            @db.Decimal(18, 2)
  fxDelta            Decimal            @db.Decimal(18, 2)
  alternatives       String[]
  userDecision       String?
  recordedAt         DateTime           @default(now())
}

model Alert {
  id          String        @id @default(uuid())
  title       String
  message     String
  priority    AlertPriority @default(IMPORTANT)
  category    String        // GOAL, CONTRIBUTION, ALLOCATION, ASSUMPTION
  createdAt   DateTime      @default(now())
  read        Boolean       @default(false)
  actionUrl   String?
  metadata    Json?
}

model GoalProjection {
  id                String   @id @default(uuid())
  goalId            String
  goal              Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  calculatedAt      DateTime @default(now())
  currentValueBRL   Decimal  @db.Decimal(18, 2)
  targetValueBRL    Decimal  @db.Decimal(18, 2)
  advisorAssessment String
  scenarios         ProjectionScenario[]
}

model ProjectionScenario {
  id                             String         @id @default(uuid())
  projectionId                   String
  projection                     GoalProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  name                           String         // Conservador, Base, Otimista
  expectedAnnualReturnUSD        Decimal        @db.Decimal(5, 2)
  monthlyContributionBRL         Decimal        @db.Decimal(18, 2)
  exchangeRate                   Decimal        @db.Decimal(18, 4)
  timelineYears                  Int
  projectedFinalValueUSD         Decimal        @db.Decimal(18, 2)
  projectedFinalValueBRL         Decimal        @db.Decimal(18, 2)
  requiredMonthlyContributionBRL Decimal        @db.Decimal(18, 2)
  estimatedYearsToReachGoal      Decimal        @db.Decimal(5, 2)
  assumptionsNotes               String
}
